import MagnitudeConjecture.Algebra.BiserialModule
import MagnitudeConjecture.Algebra.SocleModule
import Mathlib.RingTheory.HopkinsLevitzki

/-!
# Actions of the ring radical on finite-length modules

Over a semiprimary ring, the module radical is generated by the ring
Jacobson radical.  Iterating this identity identifies the second and third
module radicals with the actions of the corresponding powers of the ring
radical.  For a uniserial module of length three, a generator is consequently
sent nontrivially into the socle by some element of the square.
-/

set_option autoImplicit false

noncomputable section

namespace MagnitudeConjecture

universe u v

variable {R : Type u} [Ring R] [IsSemiprimaryRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-- Over a semiprimary ring, the radical of a module is the submodule
generated by the action of the ring Jacobson radical. -/
theorem moduleJacobson_eq_ringJacobson_smul_top :
    Module.jacobson R M = Ring.jacobson R • (⊤ : Submodule R M) := by
  apply le_antisymm
  · let J := Ring.jacobson R
    let N : Submodule R M := J • ⊤
    have htorsion : Module.IsTorsionBySet R (M ⧸ N) (J : Set R) :=
      Module.isTorsionBySet_quotient_ideal_smul M J
    letI : Module (R ⧸ J) (M ⧸ N) := htorsion.module
    have hsemisimple : IsSemisimpleModule R (M ⧸ N) :=
      htorsion.isSemisimpleModule_iff.mp (inferInstance :
        IsSemisimpleModule (R ⧸ J) (M ⧸ N))
    letI : IsSemisimpleModule R (M ⧸ N) := hsemisimple
    change Module.jacobson R M ≤ N
    rw [← N.ker_mkQ]
    exact IsSemisimpleModule.jacobson_le_ker R R M (M ⧸ N) N.mkQ
  · exact Ring.jacobson_smul_top_le R M

/-- The image in `M` of the iterated module radical is the action of the
square of the ring Jacobson radical. -/
theorem map_iteratedModuleJacobson_eq_ringJacobson_sq_smul_top :
    (Module.jacobson R (Module.jacobson R M)).map
        (Module.jacobson R M).subtype =
      Ring.jacobson R ^ 2 • (⊤ : Submodule R M) := by
  let JM := Module.jacobson R M
  change (Module.jacobson R JM).map JM.subtype = _
  rw [moduleJacobson_eq_ringJacobson_smul_top (R := R) (M := JM),
    Submodule.map_smul'', Submodule.map_top,
    Submodule.range_subtype]
  dsimp only [JM]
  rw [moduleJacobson_eq_ringJacobson_smul_top (R := R) (M := M),
    ← Submodule.mul_smul]
  have hpow : Ring.jacobson R ^ 2 =
      Ring.jacobson R * Ring.jacobson R := by
    calc
      Ring.jacobson R ^ 2 =
          Ring.jacobson R * Ring.jacobson R ^ 1 :=
        Ideal.IsTwoSided.pow_succ (I := Ring.jacobson R) 1
      _ = Ring.jacobson R * Ring.jacobson R := by
        rw [Submodule.pow_one]
  exact congrArg (fun I : Ideal R ↦ I • (⊤ : Submodule R M)) hpow.symm

/-- The image in `M` of the third iterated module radical is the action of
the cube of the ring Jacobson radical. -/
theorem map_thriceIteratedModuleJacobson_eq_ringJacobson_cube_smul_top :
    (Module.jacobson R
        (Module.jacobson R (Module.jacobson R M))).map
      ((Module.jacobson R M).subtype.comp
        (Module.jacobson R (Module.jacobson R M)).subtype) =
      Ring.jacobson R ^ 3 • (⊤ : Submodule R M) := by
  let JM := Module.jacobson R M
  let JJM := Module.jacobson R JM
  change (Module.jacobson R JJM).map (JM.subtype.comp JJM.subtype) = _
  rw [moduleJacobson_eq_ringJacobson_smul_top (R := R) (M := JJM),
    Submodule.map_smul'', Submodule.map_top, LinearMap.range_comp,
    Submodule.range_subtype]
  dsimp only [JJM, JM]
  rw [map_iteratedModuleJacobson_eq_ringJacobson_sq_smul_top,
    ← Submodule.mul_smul]
  have hpow : Ring.jacobson R ^ 3 =
      Ring.jacobson R * Ring.jacobson R ^ 2 := by
    calc
      Ring.jacobson R ^ 3 =
          Ring.jacobson R ^ (1 + 2) := by norm_num
      _ = Ring.jacobson R ^ 1 * Ring.jacobson R ^ 2 :=
        Ideal.IsTwoSided.pow_add (I := Ring.jacobson R) 1 2
      _ = Ring.jacobson R * Ring.jacobson R ^ 2 := by
        rw [Submodule.pow_one]
  exact congrArg (fun I : Ideal R ↦ I • (⊤ : Submodule R M)) hpow.symm

/-- In a length-three uniserial module, some element of the square of the
ring radical sends every vector outside the module radical to a nonzero
socle vector. -/
theorem exists_radicalSquare_smul_ne_zero_mem_socle
    [IsArtinian R M] [IsNoetherian R M] [Nontrivial M]
    (hM : IsUniserialModule R M)
    (hlength : Module.length R M = 3)
    (u : M) (hu : u ∉ Module.jacobson R M) :
    ∃ r ∈ Ring.jacobson R ^ 2,
      r • u ≠ 0 ∧ r • u ∈ moduleSocle R M := by
  let JM := Module.jacobson R M
  have htop : IsSimpleModule R (M ⧸ JM) := hM.top_isSimple
  have hJMlength : Module.length R JM = 2 :=
    IsBiserialModule.jacobson_length_eq_two_of_simple_top_of_length_eq_three
      htop hlength
  have hJMnontrivial : Nontrivial JM :=
    Module.length_pos_iff.mp (by rw [hJMlength]; norm_num)
  letI : Nontrivial JM := hJMnontrivial
  have hJMuni : IsUniserialModule R JM := hM.submodule JM
  have hJMtop : IsSimpleModule R (JM ⧸ Module.jacobson R JM) :=
    hJMuni.top_isSimple
  have hJMtopLength : Module.length R
      (JM ⧸ Module.jacobson R JM) = 1 :=
    Module.length_eq_one_iff.mpr hJMtop
  have hJMexact : Module.length R JM =
      Module.length R (Module.jacobson R JM) +
        Module.length R (JM ⧸ Module.jacobson R JM) :=
    Module.length_eq_add_of_exact
      (Module.jacobson R JM).subtype (Module.jacobson R JM).mkQ
      (Module.jacobson R JM).subtype_injective
      (Module.jacobson R JM).mkQ_surjective
      (LinearMap.exact_subtype_mkQ (Module.jacobson R JM))
  have hJMsqLength : Module.length R (Module.jacobson R JM) = 1 := by
    rw [hJMlength, hJMtopLength] at hJMexact
    apply WithTop.add_right_cancel ENat.one_ne_top
    calc
      Module.length R (Module.jacobson R JM) + 1 = 2 := hJMexact.symm
      _ = 1 + 1 := by norm_num
  have hJMsqSimple : IsSimpleModule R (Module.jacobson R JM) :=
    Module.length_eq_one_iff.mp hJMsqLength
  letI : IsSimpleModule R (Module.jacobson R JM) := hJMsqSimple
  letI : Nontrivial (Module.jacobson R JM) := hJMsqSimple.nontrivial
  obtain ⟨x, hx⟩ := exists_ne (0 : Module.jacobson R JM)
  let xm : M := JM.subtype x.1
  have hxm : xm ≠ 0 := by
    intro hzero
    apply hx
    apply Subtype.ext
    exact JM.subtype_injective hzero
  have hmapSimple : IsSimpleModule R
      ((Module.jacobson R JM).map JM.subtype) :=
    isSimpleModule_map_of_injective JM.subtype JM.subtype_injective
      (Module.jacobson R JM) hJMsqSimple
  have hxSocle : xm ∈ moduleSocle R M :=
    le_moduleSocle_of_simple _ hmapSimple ⟨x.1, x.2, rfl⟩
  have huspan : Submodule.span R {u} = ⊤ := by
    by_contra hne
    have hspanJac : Submodule.span R {u} ≤ JM :=
      IsUniserialModule.le_jacobson_of_ne_top_of_simple_top htop hne
    exact hu (hspanJac (Submodule.subset_span (Set.mem_singleton u)))
  have hxpow : xm ∈ Ring.jacobson R ^ 2 •
      Submodule.span R ({u} : Set M) := by
    rw [huspan, ← map_iteratedModuleJacobson_eq_ringJacobson_sq_smul_top]
    exact ⟨x.1, x.2, rfl⟩
  obtain ⟨r, hr, hru⟩ :=
    Submodule.mem_smul_span_singleton.mp hxpow
  exact ⟨r, hr, hru.trans_ne hxm, hru ▸ hxSocle⟩

end MagnitudeConjecture
